Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^api/v1/(.*)$ backend/api/index.php?route=$1 [QSA,L]
RewriteRule ^backend/config/ - [F,L]
RewriteRule ^backend/logs/ - [F,L]
</IfModule>

<FilesMatch "^(scratch_db|upgrade_pro|upgrade_king_barber)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
