# AlCorte Pro - Configuración de Entorno
# Copia este archivo a .env y actualiza los valores

# Base de Datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barberia_db
DB_USER=root
DB_PASS=

# Aplicación
APP_NAME=AlCorte Pro
APP_ENV=production
APP_DEBUG=false

# Sesión
SESSION_LIFETIME=3600
SESSION_SECURE=false
SESSION_HTTPONLY=true

# Seguridad
CSRF_TOKEN_LENGTH=32
PASSWORD_MIN_LENGTH=8
LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=error
